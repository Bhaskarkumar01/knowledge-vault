# --- Core ---
NODE_ENV=development
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins (required in production)
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# DB_CLIENT=sqlite (default, good for local dev / small deployments)
# DB_CLIENT=postgres (recommended for production / concurrent users)
DB_CLIENT=sqlite
DB_PATH=./db/vault.db
# Used only when DB_CLIENT=postgres:
DATABASE_URL=postgres://vault:vault@localhost:5432/vault
PGSSL=true
PG_POOL_MAX=10

# --- File storage (PDF uploads) ---
# STORAGE_DRIVER=local (default, writes to backend/uploads)
# STORAGE_DRIVER=s3 (recommended in production, or any multi-instance deploy)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_BASE=
