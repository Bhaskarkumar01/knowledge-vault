# Copy to .env in the project root before running `docker compose up`.
POSTGRES_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://your-domain.com

# Optional: S3-compatible object storage for PDF uploads.
# Leave STORAGE_DRIVER=local to just use the vault_uploads Docker volume instead.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
